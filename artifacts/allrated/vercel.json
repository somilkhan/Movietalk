{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": { "maxDuration": 30 },
    "api/bingr/stream.js": { "maxDuration": 30 },
    "api/bingr/download.js": { "maxDuration": 30 },
    "api/catalog/title/similar.js": { "maxDuration": 30 },
    "api/catalog/genre.js": { "maxDuration": 30 },
    "api/catalog/anilist.js": { "maxDuration": 30 },
    "api/progress.js": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/bingr/stream", "destination": "/api/bingr/stream" },
    { "source": "/api/bingr/download", "destination": "/api/bingr/download" },
    { "source": "/api/catalog/title/:mediaType/:id/similar", "destination": "/api/catalog/title/similar?mediaType=:mediaType&id=:id" },
    { "source": "/api/catalog/genre", "destination": "/api/catalog/genre" },
    { "source": "/api/catalog/anilist", "destination": "/api/catalog/anilist" },
    { "source": "/api/progress", "destination": "/api/progress" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
