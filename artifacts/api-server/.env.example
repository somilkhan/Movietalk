# API Server Environment Variables

# Required: Supabase PostgreSQL connection string (server-side only).
# Prefer the Supabase Transaction Pooler for Vercel/serverless deployments.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require

# Required: TMDB API key for catalog/metadata
TMDB_API_KEY=your_tmdb_api_key_here

# Required: Secret for signing session cookies (use a strong random string)
SESSION_SECRET=change_this_to_a_32_char_random_string

# Optional: Port to run the server on (default: 8080)
PORT=8080

# Optional: Node environment (development | production)
NODE_ENV=development

# Optional: CinePro Core streaming service URL
CINEPRO_URL=http://localhost:3001

# Optional: Frontend origin for CORS (required in production)
# In production, set this to your deployed frontend URL
FRONTEND_ORIGIN=https://your-domain.vercel.app

# Optional: Comma-separated list of allowed domains for the HLS proxy
# If not set, all domains are allowed (development only)
ALLOWED_PROXY_DOMAINS=

# Optional: Log level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info
