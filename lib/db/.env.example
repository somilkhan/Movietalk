# Supabase/PostgreSQL connection string used by the API server and Drizzle.
# Get this from Supabase Dashboard → Connect → Transaction pooler (recommended for serverless).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require

# Optional connection-pool tuning.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
